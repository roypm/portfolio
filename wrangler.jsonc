{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-25",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Secrets, not committed: RESEND_API_KEY, TURNSTILE_SECRET_KEY.
  // Local values go in .dev.vars. Production values are Worker secrets.
  "vars": {
    "CONTACT_TO": "roymoli15@gmail.com",
    "CONTACT_FROM": "Portfolio <contact@roypm.es>"
  }
}
