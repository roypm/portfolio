{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-25",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // The binding can only deliver to this inbox, whatever the code asks for.
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "roymoli15@gmail.com"
    }
  ],
  // Optional secret: TURNSTILE_SECRET_KEY (only if turnstileSiteKey is set).
  // Local value goes in .dev.vars. Production value is a Worker secret.
  "vars": {
    "CONTACT_TO": "roymoli15@gmail.com",
    "CONTACT_FROM": "contact@roypm.es"
  },
  // wrangler preview does not inherit the bindings above.
  "previews": {
    "vars": {
      "CONTACT_TO": "roymoli15@gmail.com",
      "CONTACT_FROM": "contact@roypm.es"
    },
    "send_email": [
      {
        "name": "EMAIL",
        "destination_address": "roymoli15@gmail.com"
      }
    ]
  }
}
