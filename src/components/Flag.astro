---
import type { Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<span class="inline-block h-3.5 w-5 shrink-0 overflow-hidden rounded-sm">
  {
    locale === "es" && (
      <svg viewBox="0 0 20 14" class="h-full w-full" aria-hidden="true">
        <rect width="20" height="14" fill="#AA151B" />
        <rect y="3.5" width="20" height="7" fill="#F1BF00" />
      </svg>
    )
  }
  {
    locale === "en" && (
      <svg viewBox="0 0 60 30" class="h-full w-full" aria-hidden="true">
        <rect width="60" height="30" fill="#012169" />
        <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
        <path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="4" />
        <path d="M30,0 V30 M0,15 H60" stroke="#fff" stroke-width="10" />
        <path d="M30,0 V30 M0,15 H60" stroke="#C8102E" stroke-width="6" />
      </svg>
    )
  }
  {
    locale === "ca" && (
      <svg viewBox="0 0 20 14" class="h-full w-full" aria-hidden="true">
        <rect width="20" height="14" fill="#FCDD09" />
        <rect y="1.56" width="20" height="1.55" fill="#DA121A" />
        <rect y="4.67" width="20" height="1.55" fill="#DA121A" />
        <rect y="7.78" width="20" height="1.55" fill="#DA121A" />
        <rect y="10.89" width="20" height="1.55" fill="#DA121A" />
      </svg>
    )
  }
</span>
