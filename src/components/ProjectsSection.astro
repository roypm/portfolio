---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { ArrowUpRight, Pin } from "@lucide/astro";
import SectionHead from "./SectionHead.astro";
import { localizedEntries } from "../i18n/content";
import type { Locale } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  locale: Locale;
  index: string;
}

const { locale, index } = Astro.props;
const t = useTranslations(locale);

const projects = localizedEntries(await getCollection("projects"), locale).sort(
  (a, b) => a.data.order - b.data.order,
);

const placeholder = "italic text-dark-slate-grey-600";
const projectPlaceholders = [0, 1, 2, 3];
const count = projects.length || projectPlaceholders.length;
---

<section id="projects" class="mt-32 scroll-mt-28 md:mt-48">
  <SectionHead index={index} title={t("nav.projects")} note={`01 — ${String(count).padStart(2, "0")}`} />

  <div class="mt-14 grid grid-cols-1 gap-x-8 gap-y-16 md:grid-cols-2 xl:grid-cols-6">
    {
      projects.length > 0
        ? projects.map((project, position) => {
            const wide = project.data.pinned;
            const card = `fx-card fx-project group relative flex h-full flex-col fx-reveal ${
              wide ? "md:col-span-2 xl:col-span-4" : "xl:col-span-2"
            }`;
            const delay = `--reveal-delay: ${Math.min(320, position * 90)}ms`;
            const body = (
              <>
                <div
                  class={`fx-project-frame relative overflow-hidden rounded-2xl bg-muted-teal-800 ${
                    wide ? "aspect-[16/10]" : "aspect-[4/3]"
                  }`}
                >
                  {project.data.image && (
                    <Image src={project.data.image} alt="" class="size-full object-cover object-top" />
                  )}
                  {project.data.pinned && (
                    <span class="absolute top-4 right-4 inline-flex size-9 items-center justify-center rounded-full bg-pacific-cyan-500 text-tea-green-900">
                      <Pin size={16} aria-hidden="true" />
                      <span class="sr-only">{t("project.pinned")}</span>
                    </span>
                  )}
                </div>
                <div class="fx-project-rule mt-6" aria-hidden="true"></div>
                <div class="mt-5 flex flex-1 gap-5">
                  <span class="fx-project-index pt-1.5 text-pacific-cyan-500" aria-hidden="true">
                    {String(position + 1).padStart(2, "0")}
                  </span>
                  <div class="flex flex-1 flex-col">
                    <h3 class="fx-project-title t-title flex items-start gap-2">
                      {project.data.title}
                      {project.data.url && (
                        <ArrowUpRight
                          class="fx-project-link mt-1 shrink-0 text-pacific-cyan-500 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"
                          size={wide ? 28 : 20}
                          aria-hidden="true"
                        />
                      )}
                    </h3>
                    <p class={`mt-3 max-w-prose text-pretty ${wide ? "t-lead" : ""}`}>{project.data.summary}</p>
                    {project.data.stack.length > 0 && (
                      <ul class="fx-project-stack mt-5 flex flex-wrap gap-x-3 gap-y-1">
                        {project.data.stack.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              </>
            );
            return project.data.url ? (
              <a
                class={`${card} rounded-2xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pacific-cyan-500`}
                href={project.data.url}
                target="_blank"
                rel="noopener noreferrer"
                data-reveal
                style={delay}
              >
                {body}
              </a>
            ) : (
              <article class={card} data-reveal style={delay}>
                {body}
              </article>
            );
          })
        : projectPlaceholders.map((slot) => (
            <article
              class={`fx-card fx-project flex h-full flex-col ${
                slot === 0 ? "md:col-span-2 xl:col-span-4" : "xl:col-span-2"
              }`}
            >
              <div
                class={`rounded-2xl bg-muted-teal-800 ${slot === 0 ? "aspect-[16/10]" : "aspect-[4/3]"}`}
                aria-hidden="true"
              ></div>
              <div class="fx-project-rule mt-6" aria-hidden="true"></div>
              <div class="mt-5 flex flex-1 gap-5">
                <span class="fx-project-index pt-1.5 text-pacific-cyan-500" aria-hidden="true">
                  {String(slot + 1).padStart(2, "0")}
                </span>
                <div class="flex flex-1 flex-col">
                  <h3 class:list={["t-title", placeholder]}>{t("placeholder.project.title")}</h3>
                  <p class:list={["mt-3", placeholder]}>{t("placeholder.project.summary")}</p>
                  <p class:list={["mt-6", placeholder]}>{t("placeholder.project.stack")}</p>
                </div>
              </div>
            </article>
          ))
    }
  </div>
</section>
