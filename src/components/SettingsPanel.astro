---
import { getRelativeLocaleUrl } from "astro:i18n";
import { PanelLeft, PanelRight, PanelTop, Settings, X } from "@lucide/astro";
import ExternalLink from "./ExternalLink.astro";
import Flag from "./Flag.astro";
import GithubIcon from "./GithubIcon.astro";
import { repositoryUrl } from "../config";
import { languageLabels, locales, type Locale } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const placements = [
  { id: "top", Icon: PanelTop },
  { id: "left", Icon: PanelLeft },
  { id: "right", Icon: PanelRight },
] as const;

const palettes = [
  { id: "slate", swatches: ["#f8f9fa", "#dee2e6", "#adb5bd", "#6c757d", "#212529"] },
  { id: "night", swatches: ["#343a40", "#495057", "#6c757d", "#ced4da", "#f8f9fa"] },
  { id: "blossom", swatches: ["#ffe5ec", "#ffc2d1", "#ffb3c6", "#ff8fab", "#fb6f92"] },
  { id: "garnet", swatches: ["#0f0606", "#2f0000", "#650000", "#b80000", "#ff5c5c"] },
] as const;
---

<button
  type="button"
  data-settings-open
  class="fx-glass inline-flex size-10 shrink-0 items-center justify-center rounded-full border border-dark-slate-grey-800 bg-tea-green-800 text-charcoal-blue-500 sm:size-11"
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="settings-panel"
  aria-label={t("settings.open")}
>
  <Settings size={18} aria-hidden="true" />
</button>

<div data-settings hidden class="pointer-events-auto fixed inset-0 z-40">
  <div data-settings-backdrop class="absolute inset-0 bg-charcoal-blue-100/40 backdrop-blur-sm"></div>
  <aside
    id="settings-panel"
    data-settings-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="settings-title"
    tabindex="-1"
    class="fx-glass absolute inset-y-0 right-0 flex w-80 max-w-[calc(100%-1.5rem)] flex-col border-l border-dark-slate-grey-800 bg-tea-green-800"
  >
    <div class="flex items-center justify-between border-b border-dark-slate-grey-800 px-4 py-4">
      <h2 id="settings-title" class="text-lg text-charcoal-blue-300">{t("settings.open")}</h2>
      <button
        type="button"
        data-settings-close
        class="inline-flex size-9 items-center justify-center rounded-full text-charcoal-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pacific-cyan-500"
        aria-label={t("settings.close")}
      >
        <X size={18} aria-hidden="true" />
      </button>
    </div>
    <div data-settings-scroll class="flex-1 overflow-y-auto px-4 py-5">
      <section>
        <h3 class="text-charcoal-blue-500">{t("settings.language")}</h3>
        <ul class="mt-2">
          {
            locales.map((code) => (
              <li>
                <a
                  data-locale-switch
                  aria-current={code === locale ? "true" : undefined}
                  class:list={[
                    "fx-settings-row flex items-center gap-3 rounded-lg px-3 py-2 text-charcoal-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pacific-cyan-500",
                    code === locale && "bg-muted-teal-800 text-pacific-cyan-500",
                  ]}
                  href={getRelativeLocaleUrl(code, "/")}
                  hreflang={code}
                >
                  <Flag locale={code} />
                  {languageLabels[code]}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      <section class="mt-8 hidden md:block">
        <h3 id="settings-nav-placement" class="text-charcoal-blue-500">{t("settings.navPlacement")}</h3>
        <div class="fx-placement mt-2" role="radiogroup" aria-labelledby="settings-nav-placement">
          {
            placements.map(({ id, Icon }) => (
              <button
                type="button"
                role="radio"
                data-nav-placement-option={id}
                aria-checked={id === "top" ? "true" : "false"}
                tabindex={id === "top" ? 0 : -1}
                class="fx-placement-option focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pacific-cyan-500"
              >
                <Icon size={15} aria-hidden="true" />
                <span>{t(`settings.navPlacement.${id}`)}</span>
              </button>
            ))
          }
        </div>
      </section>
      <section class="mt-8">
        <h3 id="settings-palette" class="text-charcoal-blue-500">{t("settings.palette")}</h3>
        <div class="mt-2" role="radiogroup" aria-labelledby="settings-palette">
          {
            palettes.map(({ id, swatches }) => (
              <button
                type="button"
                role="radio"
                data-palette-option={id}
                aria-checked={id === "slate" ? "true" : "false"}
                tabindex={id === "slate" ? 0 : -1}
                class="fx-settings-row flex w-full items-center gap-3 rounded-lg px-3 py-2 text-left text-charcoal-blue-500 aria-checked:bg-muted-teal-800 aria-checked:text-pacific-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pacific-cyan-500"
              >
                <span class="fx-swatches flex shrink-0 gap-1" aria-hidden="true">
                  {swatches.map((color) => (
                    <span
                      class="fx-swatch size-3.5 rounded-full ring-1 ring-charcoal-blue-500/30 ring-inset"
                      style={`background-color: ${color}`}
                    />
                  ))}
                </span>
                {t(`settings.palette.${id}`)}
              </button>
            ))
          }
        </div>
      </section>
      <section class="mt-8">
        <h3 id="settings-motion" class="text-charcoal-blue-500">{t("settings.motion")}</h3>
        <button
          type="button"
          role="switch"
          data-motion-switch
          aria-checked="true"
          aria-labelledby="settings-motion"
          class="fx-motion-row mt-2 flex w-full items-center justify-between gap-4 rounded-lg px-3 py-2 text-left text-charcoal-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pacific-cyan-500"
        >
          <span>
            <span data-motion-on>{t("settings.motion.on")}</span>
            <span data-motion-off>{t("settings.motion.off")}</span>
          </span>
          <span class="fx-switch">
            <span class="fx-switch-thumb"></span>
          </span>
        </button>
      </section>
    </div>
    <div class="border-t border-dark-slate-grey-800 px-4 py-4">
      <ExternalLink class="fx-settings-repo inline-flex items-center gap-2 rounded-lg text-charcoal-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pacific-cyan-500" href={repositoryUrl}>
        <GithubIcon />
        {t("repo")}
      </ExternalLink>
    </div>
  </aside>
</div>
<script>
  import "../scripts/settings-dialog";
  import "../scripts/nav-placement";
  import "../scripts/appearance";
</script>
