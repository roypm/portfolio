---
import { Font, getImage } from "astro:assets";
import { getCollection } from "astro:content";
import ContactBubble from "./ContactBubble.astro";
import ContactSection from "./ContactSection.astro";
import EducationSection from "./EducationSection.astro";
import ExperienceSection from "./ExperienceSection.astro";
import Footer from "./Footer.astro";
import HeroSection from "./HeroSection.astro";
import Nav from "./Nav.astro";
import ProjectsSection from "./ProjectsSection.astro";
import ScrollScene from "./ScrollScene.astro";
import { defaultLocale, type Locale } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import "../styles/global.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const homes = await getCollection("home");
const home = homes.find((entry) => entry.id === locale) ?? homes.find((entry) => entry.id === defaultLocale);
const name = home?.data.name ?? "";
const role = home?.data.role ?? "";
const description = home?.data.sentence ?? "";
const siteUrl = Astro.site ?? new URL("https://www.roypm.es");
const pageUrl = new URL(Astro.url.pathname, siteUrl);
const socialImage = home?.data.photo
  ? await getImage({ src: home.data.photo, width: 1200, height: 630, fit: "cover", format: "jpg" })
  : undefined;
const localeUrls = {
  es: new URL("/", siteUrl),
  en: new URL("/en/", siteUrl),
  ca: new URL("/ca/", siteUrl),
};
---

<html lang={locale} class="bg-tea-green-900">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{name ? `${name} — ${role}` : "Portfolio"}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={pageUrl} />
    {Object.entries(localeUrls).map(([code, url]) => <link rel="alternate" hreflang={code} href={url} />)}
    <link rel="alternate" hreflang="x-default" href={localeUrls.es} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "ca" ? "ca_ES" : locale === "en" ? "en_US" : "es_ES"} />
    <meta property="og:title" content={name ? `${name} — ${role}` : "Portfolio"} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    {socialImage && <meta property="og:image" content={new URL(socialImage.src, siteUrl)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={name ? `${name} — ${role}` : "Portfolio"} />
    {description && <meta name="twitter:description" content={description} />}
    {socialImage && <meta name="twitter:image" content={new URL(socialImage.src, siteUrl)} />}
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
    <style is:inline>
      html.hash-pending body {
        visibility: hidden;
      }
    </style>
    <script is:inline>
      (function () {
        var placement = "top";
        try {
          var stored = localStorage.getItem("nav-placement");
          if (stored === "left" || stored === "right" || stored === "top") placement = stored;
        } catch (e) {}
        document.documentElement.setAttribute("data-nav-placement", placement);
        var palette = "slate";
        try {
          var storedPalette = localStorage.getItem("palette");
          if (
            storedPalette === "blossom" ||
            storedPalette === "garnet" ||
            storedPalette === "slate" ||
            storedPalette === "night"
          ) {
            palette = storedPalette;
          }
        } catch (e) {}
        document.documentElement.setAttribute("data-palette", palette);
        var motion = "on";
        try {
          var storedMotion = localStorage.getItem("motion");
          if (storedMotion === "off") motion = "off";
        } catch (e) {}
        document.documentElement.setAttribute("data-motion", motion);
        if (motion === "on") document.documentElement.classList.add("fx-motion");
      })();
    </script>
    <script is:inline>
      (function () {
        var hash = location.hash;
        if (!hash || hash === "#") return;
        document.documentElement.classList.add("hash-pending");
        if ("scrollRestoration" in history) history.scrollRestoration = "manual";
      })();
    </script>
  </head>
  <body class="bg-tea-green-900 text-charcoal-blue-500">
    <div class="fx-glow-field" aria-hidden="true"></div>
    <Nav locale={locale} />
    <main class="mx-auto max-w-6xl px-5 pt-28 sm:px-8 md:pt-40">
      <HeroSection locale={locale} home={home} />
      <ProjectsSection locale={locale} index="01" />
      <ExperienceSection locale={locale} index="02" />
      <EducationSection locale={locale} index="03" />
      <ContactSection locale={locale} index="04" />
    </main>
    <ScrollScene label={t("scroll.scene")} />
    <Footer locale={locale} />
    <ContactBubble locale={locale} />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (!root.classList.contains("hash-pending")) return;
        var done = false;
        var place = function () {
          if (done) return;
          done = true;
          try {
            var id = decodeURIComponent(location.hash.slice(1));
            var el = id ? document.getElementById(id) : null;
            if (el) el.scrollIntoView();
          } finally {
            root.classList.remove("hash-pending");
          }
        };
        requestAnimationFrame(function () {
          requestAnimationFrame(place);
        });
        setTimeout(place, 400);
      })();
    </script>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var observer = null;
        function watch() {
          if (!root.classList.contains("fx-motion")) return;
          var items = document.querySelectorAll("[data-reveal]:not([data-reveal='in'])");
          if (!("IntersectionObserver" in window)) {
            items.forEach(function (item) {
              item.setAttribute("data-reveal", "in");
            });
            return;
          }
          if (!observer) {
            observer = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (!entry.isIntersecting) return;
                  entry.target.setAttribute("data-reveal", "in");
                  observer.unobserve(entry.target);
                });
              },
              { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
            );
          }
          items.forEach(function (item) {
            observer.observe(item);
          });
        }
        watch();
        root.addEventListener("motionchange", watch);
      })();
    </script>
  </body>
</html>
