---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import { ExternalLink as ExternalLinkIcon, FileText, Pin } from "@lucide/astro";
import ContactBubble from "./ContactBubble.astro";
import ContactSection from "./ContactSection.astro";
import ExternalLink from "./ExternalLink.astro";
import { localizedEntries } from "../i18n/content";
import { defaultLocale, type Locale } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";
import "../styles/global.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const homes = await getCollection("home");
const home = homes.find((entry) => entry.id === locale) ?? homes.find((entry) => entry.id === defaultLocale);
const Bio = home ? (await render(home)).Content : null;

const projects = localizedEntries(await getCollection("projects"), locale).sort(
  (a, b) => a.data.order - b.data.order,
);

const experience = localizedEntries(await getCollection("experience"), locale).sort(
  (a, b) => b.data.start.valueOf() - a.data.start.valueOf(),
);

const experienceBodies = new Map(
  await Promise.all(
    experience.map(async (entry) => [entry.id, (await render(entry)).Content] as const),
  ),
);

const education = localizedEntries(await getCollection("education"), locale)
  .filter((entry) => !entry.data.hidden)
  .sort((a, b) => {
    const byDate = b.data.start.valueOf() - a.data.start.valueOf();
    if (byDate !== 0) return byDate;
    return a.id.localeCompare(b.id);
  });
const degrees = education.filter((entry) => entry.data.kind === "degree");
const courses = education.filter((entry) => entry.data.kind === "course");

const educationBodies = new Map(
  await Promise.all(
    education.map(async (entry) => [entry.id, (await render(entry)).Content] as const),
  ),
);

const dateFormat = new Intl.DateTimeFormat(locale, { year: "numeric", month: "short" });

function educationDates(start: Date, end: Date | undefined, kind: "degree" | "course") {
  const startLabel = dateFormat.format(start);
  if (end) return `${startLabel} – ${dateFormat.format(end)}`;
  if (kind === "course") return startLabel;
  return `${startLabel} – ${t("present")}`;
}
const name = home?.data.name ?? "";
const role = home?.data.role ?? "";
const sentence = home?.data.sentence ?? "";
const focus = home?.data.focus ?? "";
const hasBio = Boolean(home?.body?.trim());
const placeholder = "italic text-dark-slate-grey-600";
const projectPlaceholders = [0, 1, 2, 3];
const experiencePlaceholders = [0, 1, 2];
const degreePlaceholders = [0, 1];
const coursePlaceholders = [0, 1];
---

<html lang={locale} class="bg-tea-green-900">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{name || "Portfolio"}</title>
    <style is:inline>
      html.hash-pending body {
        visibility: hidden;
      }
    </style>
    <script is:inline>
      (function () {
        var placement = "top";
        try {
          var stored = localStorage.getItem("nav-placement");
          if (stored === "left" || stored === "right" || stored === "top") placement = stored;
        } catch (e) {}
        document.documentElement.setAttribute("data-nav-placement", placement);
        var palette = "slate";
        try {
          var storedPalette = localStorage.getItem("palette");
          if (
            storedPalette === "garden" ||
            storedPalette === "blossom" ||
            storedPalette === "garnet" ||
            storedPalette === "slate" ||
            storedPalette === "night"
          ) {
            palette = storedPalette;
          }
        } catch (e) {}
        document.documentElement.setAttribute("data-palette", palette);
      })();
    </script>
    <script is:inline>
      (function () {
        var hash = location.hash;
        if (!hash || hash === "#") return;
        document.documentElement.classList.add("hash-pending");
        if ("scrollRestoration" in history) history.scrollRestoration = "manual";
      })();
    </script>
  </head>
  <body class="bg-tea-green-900 text-charcoal-blue-500">
    <Nav locale={locale} />
    <main class="mx-auto max-w-6xl px-4 pt-24">
      <div class="grid items-start gap-10 md:grid-cols-2">
      <section id="intro" class="scroll-mt-24">
        {
          home?.data.photo ? (
            <Image src={home.data.photo} alt="" class="mb-4 size-24 rounded-full object-cover" />
          ) : (
            <div class="mb-4 size-24 rounded-full bg-muted-teal-800" aria-hidden="true"></div>
          )
        }
        <h1 class:list={["text-3xl text-charcoal-blue-300", !name && placeholder]}>{name || t("placeholder.name")}</h1>
        <p class:list={[!role && placeholder]}>{role || t("placeholder.role")}</p>
        <p class:list={["mt-2", !sentence && placeholder]}>{sentence || t("placeholder.sentence")}</p>
      </section>

      <div class="flex flex-col gap-10">
      <section id="bio" class="scroll-mt-24">
        <h2 class="text-xl text-charcoal-blue-300">{t("nav.bio")}</h2>
        {
          hasBio && Bio ? (
            <div class="mt-4 space-y-4"><Bio /></div>
          ) : (
            <p class:list={["mt-4", placeholder]}>{t("placeholder.bio")}</p>
          )
        }
      </section>

      <section id="focus" class="scroll-mt-24">
        <h2 class="text-xl text-charcoal-blue-300">{t("nav.focus")}</h2>
        <p class:list={["mt-4", !focus && placeholder]}>{focus || t("placeholder.focus")}</p>
      </section>
      </div>
      </div>

      <section id="projects" class="mt-16 scroll-mt-24">
        <div class="mb-3 h-px bg-pacific-cyan-500" aria-hidden="true"></div>
        <h2 class="text-xl text-charcoal-blue-300">{t("nav.projects")}</h2>
        <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
          {
            projects.length > 0
              ? projects.map((project) => {
                  const card =
                    "relative flex h-full flex-col overflow-hidden rounded-lg border border-dark-slate-grey-800 bg-tea-green-800";
                  const body = (
                    <>
                      {project.data.image && (
                        <Image
                          src={project.data.image}
                          alt=""
                          class="aspect-video w-full object-cover object-top"
                        />
                      )}
                      {project.data.pinned && (
                        <span class="absolute top-3 right-3 inline-flex size-8 items-center justify-center rounded-full bg-pacific-cyan-500 text-tea-green-900">
                          <Pin size={16} aria-hidden="true" />
                          <span class="sr-only">{t("project.pinned")}</span>
                        </span>
                      )}
                      <div class="flex flex-1 flex-col p-4">
                        <h3 class="text-lg text-charcoal-blue-300">{project.data.title}</h3>
                        <p class="mt-1">{project.data.summary}</p>
                        {project.data.stack.length > 0 && <p class="mt-3">{project.data.stack.join(", ")}</p>}
                      </div>
                    </>
                  );
                  return project.data.url ? (
                    <a
                      class={`${card} hover:border-pacific-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pacific-cyan-500`}
                      href={project.data.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {body}
                    </a>
                  ) : (
                    <article class={card}>{body}</article>
                  );
                })
              : projectPlaceholders.map(() => (
                  <article class="flex h-full flex-col overflow-hidden rounded-lg border border-dark-slate-grey-800 bg-tea-green-800">
                    <div class="aspect-video w-full bg-muted-teal-800" aria-hidden="true"></div>
                    <div class="flex flex-1 flex-col p-4">
                      <h3 class:list={["text-lg", placeholder]}>{t("placeholder.project.title")}</h3>
                      <p class:list={["mt-1", placeholder]}>{t("placeholder.project.summary")}</p>
                      <p class:list={["mt-3", placeholder]}>{t("placeholder.project.stack")}</p>
                      <p class:list={["mt-2", placeholder]}>{t("placeholder.project.url")}</p>
                    </div>
                  </article>
                ))
          }
        </div>
      </section>

      <section id="experience" class="mt-16 scroll-mt-24">
        <div class="mb-3 h-px bg-pacific-cyan-500" aria-hidden="true"></div>
        <h2 class="text-xl text-charcoal-blue-300">{t("nav.experience")}</h2>
        <div class="relative mt-8 ml-2">
          <div class="absolute top-2 bottom-2 left-0 w-px bg-pacific-cyan-500" aria-hidden="true"></div>
          <ol>
            {
              experience.length > 0
                ? experience.map((entry) => {
                    const ExperienceBody = experienceBodies.get(entry.id);
                    const dates = entry.data.end
                      ? `${dateFormat.format(entry.data.start)} – ${dateFormat.format(entry.data.end)}`
                      : `${dateFormat.format(entry.data.start)} – ${t("present")}`;
                    return (
                      <li class="relative pb-10 pl-8 last:pb-0">
                        <span class="absolute top-1.5 left-0 size-3 -translate-x-1/2 rounded-full bg-pacific-cyan-500 ring-4 ring-tea-green-900" aria-hidden="true"></span>
                        <h3 class="text-lg text-charcoal-blue-300">{entry.data.role}</h3>
                        <p>{entry.data.place}</p>
                        <p>{dates}</p>
                        {ExperienceBody && (
                          <div class="mt-2 space-y-2">
                            <ExperienceBody />
                          </div>
                        )}
                      </li>
                    );
                  })
                : experiencePlaceholders.map(() => (
                    <li class="relative pb-10 pl-8 last:pb-0">
                      <span class="absolute top-1.5 left-0 size-3 -translate-x-1/2 rounded-full bg-pacific-cyan-500 ring-4 ring-tea-green-900" aria-hidden="true"></span>
                      <h3 class:list={["text-lg", placeholder]}>{t("placeholder.experience.role")}</h3>
                      <p class={placeholder}>{t("placeholder.experience.place")}</p>
                      <p class={placeholder}>{t("placeholder.experience.dates")}</p>
                      <p class:list={["mt-2", placeholder]}>{t("placeholder.experience.body")}</p>
                    </li>
                  ))
            }
          </ol>
        </div>
      </section>

      <section id="education" class="mt-16 scroll-mt-24">
        <div class="mb-3 h-px bg-pacific-cyan-500" aria-hidden="true"></div>
        <h2 class="text-xl text-charcoal-blue-300">{t("nav.education")}</h2>
        <div class="relative mt-8 ml-2">
          <div class="absolute top-2 bottom-2 left-0 w-px bg-pacific-cyan-500" aria-hidden="true"></div>
          <ol>
            {
              degrees.length > 0
                ? degrees.map((entry) => {
                    const DegreeBody = educationBodies.get(entry.id);
                    return (
                      <li class="relative pb-10 pl-8 last:pb-0">
                        <span class="absolute top-1.5 left-0 size-3 -translate-x-1/2 rounded-full bg-pacific-cyan-500 ring-4 ring-tea-green-900" aria-hidden="true"></span>
                        <h3 class="text-lg text-charcoal-blue-300">{entry.data.title}</h3>
                        <p>{entry.data.place}</p>
                        <p>{educationDates(entry.data.start, entry.data.end, "degree")}</p>
                        {DegreeBody && (
                          <div class="mt-2 space-y-2">
                            <DegreeBody />
                          </div>
                        )}
                      </li>
                    );
                  })
                : degreePlaceholders.map(() => (
                    <li class="relative pb-10 pl-8 last:pb-0">
                      <span class="absolute top-1.5 left-0 size-3 -translate-x-1/2 rounded-full bg-pacific-cyan-500 ring-4 ring-tea-green-900" aria-hidden="true"></span>
                      <h3 class:list={["text-lg", placeholder]}>{t("placeholder.education.title")}</h3>
                      <p class={placeholder}>{t("placeholder.education.place")}</p>
                      <p class={placeholder}>{t("placeholder.education.dates")}</p>
                      <p class:list={["mt-2", placeholder]}>{t("placeholder.education.body")}</p>
                    </li>
                  ))
            }
          </ol>
        </div>

        <h3 class="mt-10 text-lg text-charcoal-blue-300">{t("education.courses")}</h3>
        <ul class="mt-4 grid grid-cols-1 items-start gap-4 md:grid-cols-2 lg:grid-cols-4">
          {
            courses.length > 0
              ? courses.map((entry) => {
                  return (
                    <li class="flex h-full flex-col rounded-lg border border-dark-slate-grey-800 bg-tea-green-800 p-3">
                      <h4 class="text-charcoal-blue-300">{entry.data.title}</h4>
                      <p>{entry.data.place}</p>
                      <p>{educationDates(entry.data.start, entry.data.end, "course")}</p>
                      {(entry.data.certificate || entry.data.url) && (
                        <div class="mt-2 flex items-center gap-4">
                          {entry.data.certificate && (
                            <ExternalLink class="inline-flex items-center gap-1 text-pacific-cyan-500" href={entry.data.certificate}>
                              <FileText size={16} aria-hidden="true" />
                              {t("education.certificate")}
                            </ExternalLink>
                          )}
                          {entry.data.url && (
                            <ExternalLink class="text-pacific-cyan-500" href={entry.data.url} aria-label={t("education.course")}>
                              <ExternalLinkIcon size={16} aria-hidden="true" />
                            </ExternalLink>
                          )}
                        </div>
                      )}
                    </li>
                  );
                })
              : coursePlaceholders.map(() => (
                  <li class="flex h-full flex-col rounded-lg border border-dark-slate-grey-800 bg-tea-green-800 p-4">
                    <h4 class:list={["text-lg", placeholder]}>{t("placeholder.course.title")}</h4>
                    <p class={placeholder}>{t("placeholder.course.place")}</p>
                    <p class={placeholder}>{t("placeholder.course.dates")}</p>
                    <p class:list={["mt-2 inline-flex items-center gap-1", placeholder]}>
                      <FileText size={16} aria-hidden="true" />
                      {t("placeholder.course.certificate")}
                    </p>
                  </li>
                ))
          }
        </ul>
      </section>

      <ContactSection locale={locale} />
    </main>
    <section aria-label={t("scroll.sample")} class="relative h-[300vh]">
      <div class="sticky top-0 flex h-screen items-center justify-center px-4">
        <div class="flex aspect-video w-full max-w-4xl items-center justify-center rounded-lg border border-dashed border-dark-slate-grey-800 bg-muted-teal-800 p-6">
          <p class="text-center italic text-dark-slate-grey-600">{t("scroll.sample")}</p>
        </div>
      </div>
    </section>
    <Footer locale={locale} />
    <ContactBubble locale={locale} />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (!root.classList.contains("hash-pending")) return;
        var done = false;
        var place = function () {
          if (done) return;
          done = true;
          try {
            var id = decodeURIComponent(location.hash.slice(1));
            var el = id ? document.getElementById(id) : null;
            if (el) el.scrollIntoView();
          } finally {
            root.classList.remove("hash-pending");
          }
        };
        requestAnimationFrame(function () {
          requestAnimationFrame(place);
        });
        setTimeout(place, 400);
      })();
    </script>
  </body>
</html>
