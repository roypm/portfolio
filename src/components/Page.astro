---
import { Font } from "astro:assets";
import { getCollection } from "astro:content";
import ContactBubble from "./ContactBubble.astro";
import ContactSection from "./ContactSection.astro";
import EducationSection from "./EducationSection.astro";
import ExperienceSection from "./ExperienceSection.astro";
import Footer from "./Footer.astro";
import HeroSection from "./HeroSection.astro";
import Nav from "./Nav.astro";
import ProjectsSection from "./ProjectsSection.astro";
import ScrollScene from "./ScrollScene.astro";
import { defaultLocale, type Locale } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import "../styles/global.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const homes = await getCollection("home");
const home = homes.find((entry) => entry.id === locale) ?? homes.find((entry) => entry.id === defaultLocale);
const name = home?.data.name ?? "";
const role = home?.data.role ?? "";
const description = home?.data.sentence ?? "";
---

<html lang={locale} class="bg-tea-green-900">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{name ? `${name} — ${role}` : "Portfolio"}</title>
    {description && <meta name="description" content={description} />}
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
    <style is:inline>
      html.hash-pending body {
        visibility: hidden;
      }
    </style>
    <script is:inline>
      (function () {
        var placement = "top";
        try {
          var stored = localStorage.getItem("nav-placement");
          if (stored === "left" || stored === "right" || stored === "top") placement = stored;
        } catch (e) {}
        document.documentElement.setAttribute("data-nav-placement", placement);
        var palette = "slate";
        try {
          var storedPalette = localStorage.getItem("palette");
          if (
            storedPalette === "garden" ||
            storedPalette === "blossom" ||
            storedPalette === "garnet" ||
            storedPalette === "slate" ||
            storedPalette === "night"
          ) {
            palette = storedPalette;
          }
        } catch (e) {}
        document.documentElement.setAttribute("data-palette", palette);
      })();
    </script>
    <script is:inline>
      (function () {
        var hash = location.hash;
        if (!hash || hash === "#") return;
        document.documentElement.classList.add("hash-pending");
        if ("scrollRestoration" in history) history.scrollRestoration = "manual";
      })();
    </script>
  </head>
  <body class="bg-tea-green-900 text-charcoal-blue-500">
    <div class="fx-glow-field" aria-hidden="true"></div>
    <Nav locale={locale} />
    <main class="mx-auto max-w-6xl px-5 pt-28 sm:px-8 md:pt-40">
      <HeroSection locale={locale} />
      <ProjectsSection locale={locale} index="01" />
      <ExperienceSection locale={locale} index="02" />
      <EducationSection locale={locale} index="03" />
      <ContactSection locale={locale} index="04" />
    </main>
    <ScrollScene label={t("scroll.scene")} />
    <Footer locale={locale} />
    <ContactBubble locale={locale} />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (!root.classList.contains("hash-pending")) return;
        var done = false;
        var place = function () {
          if (done) return;
          done = true;
          try {
            var id = decodeURIComponent(location.hash.slice(1));
            var el = id ? document.getElementById(id) : null;
            if (el) el.scrollIntoView();
          } finally {
            root.classList.remove("hash-pending");
          }
        };
        requestAnimationFrame(function () {
          requestAnimationFrame(place);
        });
        setTimeout(place, 400);
      })();
    </script>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        root.classList.add("fx-motion");
        var items = document.querySelectorAll("[data-reveal]");
        if (!("IntersectionObserver" in window)) {
          items.forEach(function (item) {
            item.setAttribute("data-reveal", "in");
          });
          return;
        }
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.setAttribute("data-reveal", "in");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        items.forEach(function (item) {
          observer.observe(item);
        });
      })();
    </script>
  </body>
</html>
