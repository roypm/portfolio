---
import { Briefcase, FolderKanban, GraduationCap, User } from "@lucide/astro";
import SettingsPanel from "./SettingsPanel.astro";
import { type Locale, type UiKey } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const sections = [
  { id: "intro", Icon: User },
  { id: "projects", Icon: FolderKanban },
  { id: "experience", Icon: Briefcase },
  { id: "education", Icon: GraduationCap },
] as const;
---

<header data-nav-bar>
  <div data-nav-cluster>
    <nav
      data-nav-menu
      class="fx-glass flex min-w-0 overflow-x-auto rounded-full border px-1.5 py-1.5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      aria-label={t("nav.label")}
    >
      <ul data-nav-list class="relative flex items-center gap-0.5 sm:gap-1">
        <li data-nav-liquid-holder aria-hidden="true"><span data-nav-liquid></span></li>
        {
          sections.map(({ id, Icon }) => (
            <li data-nav-item class="relative z-10">
              <a
                data-nav
                class="relative block rounded-full px-3 py-2 text-[0.8125rem] tracking-wide whitespace-nowrap text-charcoal-blue-500 transition-colors duration-300 hover:text-charcoal-blue-300 aria-[current=location]:text-pacific-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pacific-cyan-500 sm:px-4"
                href={`#${id}`}
              >
                <span data-nav-icon>
                  <Icon size={18} aria-hidden="true" />
                </span>
                <span data-nav-label class="nav-tooltip">{t(`nav.${id}` as UiKey)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <SettingsPanel locale={locale} />
  </div>
</header>

<script>
  const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-nav]");
  const sections = [...navLinks]
    .map((link) => document.querySelector(link.hash))
    .filter((section): section is HTMLElement => section instanceof HTMLElement);
  const navList = document.querySelector<HTMLElement>("[data-nav-list]");
  const liquid = navList?.querySelector<HTMLElement>("[data-nav-liquid]");
  let hoveredLink: HTMLAnchorElement | null = null;
  let pendingLink: HTMLAnchorElement | null = null;
  let pendingReleaseTimer = 0;

  function moveLiquid(link: HTMLAnchorElement | null) {
    if (!navList || !liquid) return;
    if (!link) {
      liquid.dataset.visible = "false";
      return;
    }
    const listRect = navList.getBoundingClientRect();
    const linkRect = link.getBoundingClientRect();
    liquid.style.width = `${linkRect.width}px`;
    liquid.style.height = `${linkRect.height}px`;
    liquid.style.transform = `translate3d(${linkRect.left - listRect.left}px, ${linkRect.top - listRect.top}px, 0)`;
    liquid.dataset.visible = "true";
  }

  function activeLink() {
    return document.querySelector<HTMLAnchorElement>("[data-nav][aria-current='location']");
  }

  function moveToCurrentState() {
    moveLiquid(hoveredLink ?? pendingLink ?? activeLink());
  }

  function finishPendingNavigation() {
    window.clearTimeout(pendingReleaseTimer);
    if (!pendingLink) return;
    pendingLink = null;
    highlightSectionAtTop();
    moveToCurrentState();
  }

  function highlight(id: string) {
    for (const link of navLinks) {
      if (link.hash === `#${id}`) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    }
    if (pendingLink?.hash === `#${id}`) pendingLink = null;
    if (!hoveredLink) moveToCurrentState();
  }

  for (const link of navLinks) {
    link.addEventListener("pointerenter", () => {
      hoveredLink = link;
      moveLiquid(link);
    });
    link.addEventListener("focus", () => moveLiquid(link));
    link.addEventListener("blur", () => {
      if (hoveredLink === link) hoveredLink = null;
      moveToCurrentState();
    });
    link.addEventListener("click", () => {
      if (link.getAttribute("aria-current") === "location") {
        pendingLink = null;
        moveToCurrentState();
        return;
      }
      pendingLink = link;
      window.clearTimeout(pendingReleaseTimer);
      moveToCurrentState();
    });
  }

  navList?.addEventListener("pointerleave", () => {
    hoveredLink = null;
    moveToCurrentState();
  });

  function highlightSectionAtTop() {
    const margin = sections[0] ? Number.parseFloat(getComputedStyle(sections[0]).scrollMarginTop) : 0;
    const marker = margin + 8;
    let current = sections[0];
    let bestTop = Number.NEGATIVE_INFINITY;
    for (const section of sections) {
      const top = section.getBoundingClientRect().top;
      if (top <= marker && top > bestTop) {
        bestTop = top;
        current = section;
      }
    }
    if (current) highlight(current.id);
  }

  highlightSectionAtTop();

  if ("IntersectionObserver" in window && sections.length > 0) {
    const margin = Number.parseFloat(getComputedStyle(sections[0]!).scrollMarginTop) || 0;
    const intersecting = new Set<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) intersecting.add(entry.target);
          else intersecting.delete(entry.target);
        }
        const current = [...intersecting].sort(
          (a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top,
        )[0];
        if (current instanceof HTMLElement) highlight(current.id);
        else highlightSectionAtTop();
      },
      { rootMargin: `-${margin + 8}px 0px -65% 0px`, threshold: 0 },
    );
    sections.forEach((section) => observer.observe(section));
  } else {
    document.addEventListener("scroll", highlightSectionAtTop, { passive: true });
  }

  window.addEventListener("scrollend", finishPendingNavigation);
  window.addEventListener(
    "scroll",
    () => {
      if (!pendingLink) return;
      window.clearTimeout(pendingReleaseTimer);
      pendingReleaseTimer = window.setTimeout(finishPendingNavigation, 180);
    },
    { passive: true },
  );

  if (navList && "ResizeObserver" in window) {
    const resizeObserver = new ResizeObserver(moveToCurrentState);
    resizeObserver.observe(navList);
    navLinks.forEach((link) => resizeObserver.observe(link));
    window.addEventListener("resize", moveToCurrentState, { passive: true });
  }

  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-locale-switch]")) {
    link.addEventListener("click", () => {
      const current = document.querySelector<HTMLAnchorElement>(
        "[data-nav][aria-current='location']",
      );
      if (current?.hash) link.hash = current.hash;
    });
  }
</script>
