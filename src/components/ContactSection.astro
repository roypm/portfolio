---
import { turnstileSiteKey } from "../config";
import type { Locale } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const fieldClass =
  "w-full rounded-lg border border-dark-slate-grey-800 bg-tea-green-900 px-3 py-1.5 text-sm text-charcoal-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pacific-cyan-500";
---

<section id="contact" class="mt-16 scroll-mt-24 fx-reveal" data-reveal>
  <div class="fx-section-line mb-3" aria-hidden="true"></div>
  <div class="grid items-start gap-8 md:grid-cols-2 md:gap-10">
    <div class="fx-reveal" data-reveal style="--reveal-delay: 100ms">
      <h2 class="text-3xl text-charcoal-blue-300">{t("contact.title")}</h2>
      <p class="mt-4 text-lg">{t("contact.lead")}</p>
    </div>
    <form
      data-contact-form
      data-send={t("contact.send")}
      data-sending={t("contact.sending")}
      data-success={t("contact.success")}
      data-error={t("contact.error")}
      class="fx-glass relative flex flex-col gap-2 rounded-2xl border border-dark-slate-grey-800 p-5 md:p-6"
      novalidate
    >
      <label class="flex flex-col gap-1 text-sm text-charcoal-blue-500">
        {t("contact.name")}
        <input class={`${fieldClass} transition-shadow duration-300`} type="text" name="name" autocomplete="name" required />
      </label>
      <label class="flex flex-col gap-1 text-sm text-charcoal-blue-500">
        {t("contact.email")}
        <input class={`${fieldClass} transition-shadow duration-300`} type="email" name="email" autocomplete="email" required />
      </label>
      <label class="flex flex-col gap-1 text-sm text-charcoal-blue-500">
        {t("contact.message")}
        <textarea class={`${fieldClass} min-h-20 resize-y transition-shadow duration-300`} name="message" rows="4" required></textarea>
      </label>
      <div class="pointer-events-none absolute m-[-1px] h-px w-px overflow-hidden border-0 p-0" aria-hidden="true">
        <label>
          Company
          <input type="text" name="company" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      {
        turnstileSiteKey && (
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto"></div>
        )
      }
      <p data-contact-status class="min-h-5 text-sm text-charcoal-blue-500" role="status" aria-live="polite"></p>
      <button
        type="submit"
        class="fx-button mt-1 inline-flex h-10 items-center justify-center self-start rounded-full bg-pacific-cyan-500 px-5 text-sm text-tea-green-900 shadow-md transition-transform duration-300 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pacific-cyan-500 disabled:opacity-60"
      >
        {t("contact.send")}
      </button>
    </form>
  </div>
</section>

{
  turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}

<script>
  import { visibleContact } from "../contact";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const status = form.querySelector<HTMLElement>("[data-contact-status]");
    if (!button || !status) return;

    const data = new FormData(form);
    const visible = visibleContact(data.get("name"), data.get("email"), data.get("message"));
    if (!visible) {
      setStatus(status, form.dataset.error ?? "", "error");
      return;
    }

    button.disabled = true;
    button.textContent = form.dataset.sending ?? "";
    status.textContent = "";
    form.setAttribute("aria-busy", "true");

    try {
      const response = await fetch("/api/contact", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          ...visible,
          company: String(data.get("company") ?? ""),
          turnstileToken: String(data.get("cf-turnstile-response") ?? ""),
        }),
      });
      const payload = (await response.json().catch(() => null)) as { ok?: boolean } | null;
      if (!response.ok || !payload?.ok) {
        setStatus(status, form.dataset.error ?? "", "error");
        resetTurnstile();
        return;
      }
      form.reset();
      resetTurnstile();
      setStatus(status, form.dataset.success ?? "", "success");
    } catch {
      setStatus(status, form.dataset.error ?? "", "error");
      resetTurnstile();
    } finally {
      button.disabled = false;
      button.textContent = form.dataset.send ?? "";
      form.removeAttribute("aria-busy");
    }
  });

  function resetTurnstile() {
    const widget = window as Window & { turnstile?: { reset: () => void } };
    widget.turnstile?.reset();
  }

  function setStatus(element: HTMLElement, text: string, state: "success" | "error" | "") {
    element.textContent = text;
    if (state) element.dataset.state = state;
    else delete element.dataset.state;
  }
</script>
