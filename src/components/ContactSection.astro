---
import { ArrowRight } from "@lucide/astro";
import SectionHead from "./SectionHead.astro";
import { turnstileSiteKey } from "../config";
import type { Locale } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  locale: Locale;
  index: string;
}

const { locale, index } = Astro.props;
const t = useTranslations(locale);
const labelClass = "t-eyebrow";
---

<section id="contact" class="mt-32 scroll-mt-28 md:mt-48">
  <SectionHead index={index} title={t("contact.title")} />
  <div class="mt-14 grid items-start gap-x-16 gap-y-12 md:grid-cols-2">
    <div class="fx-reveal" data-reveal style="--reveal-delay: 100ms">
      <p class="t-lead max-w-md text-pretty">{t("contact.lead")}</p>
    </div>
    <form
      data-contact-form
      data-send={t("contact.send")}
      data-sending={t("contact.sending")}
      data-success={t("contact.success")}
      data-error={t("contact.error")}
      class="fx-reveal relative flex flex-col gap-7"
      data-reveal
      style="--reveal-delay: 180ms"
      novalidate
    >
      <label class="flex flex-col gap-2">
        <span class={labelClass}>{t("contact.name")}</span>
        <input class="field" type="text" name="name" autocomplete="name" required />
      </label>
      <label class="flex flex-col gap-2">
        <span class={labelClass}>{t("contact.email")}</span>
        <input class="field" type="email" name="email" autocomplete="email" required />
      </label>
      <label class="flex flex-col gap-2">
        <span class={labelClass}>{t("contact.message")}</span>
        <textarea class="field min-h-24 resize-y" name="message" rows="4" required></textarea>
      </label>
      <div class="pointer-events-none absolute m-[-1px] h-px w-px overflow-hidden border-0 p-0" aria-hidden="true">
        <label>
          Company
          <input type="text" name="company" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      {
        turnstileSiteKey && (
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto"></div>
        )
      }
      <p data-contact-status class="min-h-5 text-sm" role="status" aria-live="polite"></p>
      <button
        type="submit"
        class="fx-button group inline-flex h-12 items-center justify-center gap-2 self-start rounded-full px-7 text-sm tracking-wide transition-transform duration-300 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pacific-cyan-500 disabled:opacity-60"
      >
        <span class="relative z-1" data-button-label>{t("contact.send")}</span>
        <ArrowRight
          class="relative z-1 transition-transform duration-300 group-hover:translate-x-1"
          size={16}
          aria-hidden="true"
        />
      </button>
    </form>
  </div>
</section>

{
  turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}

<script>
  import { visibleContact } from "../contact";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const label = form.querySelector<HTMLElement>("[data-button-label]");
    const status = form.querySelector<HTMLElement>("[data-contact-status]");
    if (!button || !label || !status) return;

    const data = new FormData(form);
    const visible = visibleContact(data.get("name"), data.get("email"), data.get("message"));
    if (!visible) {
      setStatus(status, form.dataset.error ?? "", "error");
      return;
    }

    button.disabled = true;
    label.textContent = form.dataset.sending ?? "";
    status.textContent = "";
    form.setAttribute("aria-busy", "true");

    try {
      const response = await fetch("/api/contact", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          ...visible,
          company: String(data.get("company") ?? ""),
          turnstileToken: String(data.get("cf-turnstile-response") ?? ""),
        }),
      });
      const payload = (await response.json().catch(() => null)) as { ok?: boolean } | null;
      if (!response.ok || !payload?.ok) {
        setStatus(status, form.dataset.error ?? "", "error");
        resetTurnstile();
        return;
      }
      form.reset();
      resetTurnstile();
      setStatus(status, form.dataset.success ?? "", "success");
    } catch {
      setStatus(status, form.dataset.error ?? "", "error");
      resetTurnstile();
    } finally {
      button.disabled = false;
      label.textContent = form.dataset.send ?? "";
      form.removeAttribute("aria-busy");
    }
  });

  function resetTurnstile() {
    const widget = window as Window & { turnstile?: { reset: () => void } };
    widget.turnstile?.reset();
  }

  function setStatus(element: HTMLElement, text: string, state: "success" | "error" | "") {
    element.textContent = text;
    if (state) element.dataset.state = state;
    else delete element.dataset.state;
  }
</script>
